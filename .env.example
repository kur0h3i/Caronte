# Copia este fichero a .env y ajústalo. .env no se sube al repositorio.

CARONTE_ADMIN_USER=admin
# Obligatoria, mínimo 8 caracteres. Genera una con: openssl rand -base64 24
CARONTE_ADMIN_PASSWORD=

# Puerto en el que escucha Caronte (dentro y fuera del contenedor)
CARONTE_PORT=8000

# Timeout por sentencia SQL, en segundos
CARONTE_STATEMENT_TIMEOUT=5

# Pon true si sirves Caronte por HTTPS (p. ej. con `tailscale serve`)
CARONTE_COOKIE_SECURE=false

# Conexiones también por variable de entorno (alternativa al TOML):
# CARONTE_DB_MI_BD=postgresql://usuario:clave@host.docker.internal:5432/bd
