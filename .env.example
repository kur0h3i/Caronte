# Copia este fichero a .env (cp .env.example .env) y rellénalo.
# .env no se sube al repositorio.

# --- Obligatorio ------------------------------------------------------------------

# Usuario y contraseña para entrar en Caronte. La contraseña: mínimo 8 caracteres.
# Para generar una: openssl rand -base64 18
CARONTE_ADMIN_USER=admin
CARONTE_ADMIN_PASSWORD=

# Puerto en el que se abre Caronte: http://<servidor>:<puerto>
CARONTE_PORT=8000

# --- Si tus bases de datos están en el mismo servidor (localhost) ------------------

# Quita la almohadilla (#) de la línea siguiente. Así el contenedor usa la red del
# servidor y en connections.toml puedes escribir "localhost". (Solo Linux.)
# COMPOSE_FILE=docker-compose.yml:docker-compose.host.yml

# --- Opcional ---------------------------------------------------------------------

# Segundos que puede tardar una consulta antes de cancelarse
CARONTE_STATEMENT_TIMEOUT=5

# true si abres Caronte por HTTPS (p. ej. con `tailscale serve`)
CARONTE_COOKIE_SECURE=false
